#!/usr/bin/env python3
"""
Hartley: Modern AI Terminal Agent for macOS powered by Gemini.
"""

import os
import sys

# Ensure the package root is in sys.path even when invoked via symlink
script_dir = os.path.dirname(os.path.realpath(__file__))
if script_dir not in sys.path:
    sys.path.insert(0, script_dir)

try:
    from hartley_agent.cli import main
except ImportError as e:
    sys.stderr.write(f"Error loading Hartley: {e}\n")
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
